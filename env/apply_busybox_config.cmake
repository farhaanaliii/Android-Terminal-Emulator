# Applies the committed BusyBox config fragment (env/busybox.config.fragment)
# to a .config freshly generated by "make defconfig". Every symbol named in
# the fragment replaces the corresponding line in .config (whether it was
# set or not set); fragment symbols missing from .config are appended.
# Driven from the ExternalProject configure step in
# term/src/main/jni/CMakeLists.txt with -DBUSYBOX_CONFIG and -DFRAGMENT.

# Script mode does not inherit the project's policy settings; IN_LIST
# needs CMP0057.
cmake_policy(SET CMP0057 NEW)

file(READ "${BUSYBOX_CONFIG}" config_text)
file(READ "${FRAGMENT}" fragment_text)
string(REPLACE "\n" ";" config_lines "${config_text}")
string(REPLACE "\n" ";" fragment_lines "${fragment_text}")

set(fragment_symbols "")
foreach(fragment_line IN LISTS fragment_lines)
    if(fragment_line MATCHES "CONFIG_[A-Z0-9_]+")
        string(REGEX MATCH "CONFIG_[A-Z0-9_]+" symbol "${fragment_line}")
        list(APPEND fragment_symbols "${symbol}")
        set(FRAGMENT_LINE_${symbol} "${fragment_line}")
    endif()
endforeach()

set(result_lines "")
set(applied_symbols "")
foreach(config_line IN LISTS config_lines)
    set(line "${config_line}")
    if(config_line MATCHES "CONFIG_[A-Z0-9_]+")
        string(REGEX MATCH "CONFIG_[A-Z0-9_]+" symbol "${config_line}")
        if(symbol IN_LIST fragment_symbols)
            set(line "${FRAGMENT_LINE_${symbol}}")
            list(APPEND applied_symbols "${symbol}")
        endif()
    endif()
    list(APPEND result_lines "${line}")
endforeach()

foreach(symbol IN LISTS fragment_symbols)
    if(NOT symbol IN_LIST applied_symbols)
        list(APPEND result_lines "${FRAGMENT_LINE_${symbol}}")
    endif()
endforeach()

string(REPLACE ";" "\n" result "${result_lines}")
file(WRITE "${BUSYBOX_CONFIG}" "${result}\n")
