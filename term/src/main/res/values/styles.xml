<resources>
    <!-- The base theme, used for all activities. Chrome (toolbars,
         dialogs, menus) follows Material 3; the terminal view keeps its
         own colour scheme from the app preferences.
     -->
    <style name="Theme" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.TermPreferences" parent="@style/Theme">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>
</resources>
